# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Database
DATABASE_URL=postgresql://app:app@localhost:5433/carwatch

# ML Model Paths (defaults to server/models/ if not set)
# ML_MODEL_PATH=../data/models/final_model_uncertainty.cbm
# ML_STAGE2_PATH=../data/models/stage2_luxury_model.cbm
# ML_CALIBRATION_PATH=../data/models/calibration_info.json

# Scraping interval (hours between scrape jobs)
SCRAPE_INTERVAL_HOURS=5

# Image expiry: HEAD-check all listing images for 404s (uses proxy traffic, set false to save costs)
ENABLE_IMAGE_EXPIRY=true

# Oxylabs Proxy (for scraping)
OXY_PROXY_HOST=pr.oxylabs.io
OXY_PROXY_PORT=7777
OXY_PROXY_USER=
OXY_PROXY_PASS=

# DubiCars Scraper Configuration
DUBICARS_ENABLED=true
DUBICARS_MAX_PAGES=5
DUBICARS_SLEEP_BROWSE=2.0
DUBICARS_SLEEP_DETAIL=1.5
DUBICARS_MAX_CONSECUTIVE_BLOCKS=3

# Supabase Auth (from Supabase dashboard -> Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini AI (for chat feature)
GEMINI_API_KEY=your-gemini-api-key

# --- Production (Railway + Supabase) ---
# DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
# CORS_ORIGINS=https://your-app.vercel.app
# DEBUG=false
