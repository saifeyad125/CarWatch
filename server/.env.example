# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ML Model Path
ML_MODEL_PATH=../data/models/final_model_uncertainty.cbm
ML_CALIBRATION_PATH=../data/models/calibration_info.json

# Database
DATABASE_URL=postgresql://app:app@localhost:5433/carwatch

# Image expiry: HEAD-check all listing images for 404s (uses proxy traffic, set false to save costs)
ENABLE_IMAGE_EXPIRY=true

# Oxylabs Proxy (for scraping)
OXY_PROXY_HOST=pr.oxylabs.io
OXY_PROXY_PORT=7777
OXY_PROXY_USER=
OXY_PROXY_PASS=

# Supabase Auth (JWT secret from Supabase dashboard → Settings → API)
SUPABASE_JWT_SECRET=your-jwt-secret

# --- Production (Railway + Supabase) ---
# DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
# CORS_ORIGINS=https://your-app.vercel.app
# DEBUG=false
